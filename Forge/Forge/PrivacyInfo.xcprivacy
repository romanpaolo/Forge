<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ScopeSnap does not track users or link data across apps. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No third-party tracking domains. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
        Required-Reasons APIs used by ScopeSnap or its dependencies.
        File timestamp: SwiftData reads file modification dates internally.
        UserDefaults: System frameworks (AVFoundation, SwiftData) access UserDefaults.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- C617.1: Access timestamps for app's own files written by the app itself -->
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: Access info from own app's UserDefaults (system frameworks) -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>

    <!--
        Data collected by ScopeSnap.
        Audio recordings and photos are user-generated construction documentation.
        They are stored on-device and sent to Anthropic's Claude API for transcription.
        No data is sold. No data is used for advertising.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Audio recordings of job walks -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeAudioData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Photos captured from Ray-Ban Meta glasses during job walks -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhotosOrVideos</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
